# Copy to .env and fill in. Never commit your real .env file (it is git-ignored).
# Without these settings Sephra runs in retrieval-only mode (no API key needed).

SEPHRA_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-key-here
# Free model used during development (a preview model; check it still exists on openrouter.ai/models)
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
